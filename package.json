{
  "name": "miku-docx2md",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "pretest": "npm run build",
    "test": "vitest run",
    "pretest:unit": "npm run build",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "cli": "node scripts/miku-docx2md-cli.mjs",
    "smoke:version": "node scripts/miku-docx2md-cli.mjs --version",
    "smoke:bundle": "node scripts/smoke-cli-bundle.mjs",
    "smoke:runtime": "node scripts/smoke-runtime-bundle.mjs",
    "build": "node scripts/build-miku-docx2md.mjs",
    "prebuild:bundle": "npm run build",
    "build:bundle": "node scripts/build-cli-bundle.mjs",
    "prebuild:runtime": "npm run build",
    "build:runtime": "node scripts/build-runtime-bundle.mjs",
    "build:all": "npm run build:bundle && npm run build:runtime"
  },
  "devDependencies": {
    "@xmldom/xmldom": "^0.9.9",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
